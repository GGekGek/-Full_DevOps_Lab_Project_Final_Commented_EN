{
  "info": {
    "name": "Internship Application API Tests",
    "description": "Labs 5-6 – REST API of the Internship Application project (Jira SCRUM). Start the API with `npm run dev`, then run the whole collection in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Core",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "GET /version",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Version is a string\", function () {",
                  "    pm.expect(pm.response.json().version).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "version"
              ]
            }
          }
        },
        {
          "name": "GET /info",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Info has name, version, node, uptime\", function () {",
                  "    pm.expect(pm.response.json()).to.include.all.keys(\"name\", \"version\", \"node\", \"uptime\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "info"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Students (SCRUM-39)",
      "item": [
        {
          "name": "GET all students",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body is correct\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    json.forEach(s => pm.expect(s).to.include.all.keys('id', 'firstName', 'lastName', 'email', 'program', 'skills', 'cvUrl'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            }
          }
        },
        {
          "name": "GET students by skill",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body is correct\", function () {",
                  "    const json = pm.response.json();",
                  "    json.forEach(s => pm.expect(s.skills.map(k => k.toLowerCase())).to.include('python'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students?skill=Python",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ],
              "query": [
                {
                  "key": "skill",
                  "value": "Python"
                }
              ]
            }
          }
        },
        {
          "name": "POST new student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response body is correct\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json.skills).to.eql([]);",
                  "    pm.expect(json.cvUrl).to.eql(null);",
                  "    pm.collectionVariables.set(\"studentId\", json.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nora\",\n  \"lastName\": \"Diallo\",\n  \"email\": \"nora.diallo@edu.devinci.fr\",\n  \"program\": \"A4 DIA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET student by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body is correct\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.firstName).to.eql('Nora');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}"
              ]
            }
          }
        },
        {
          "name": "PUT student skills and CV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body is correct\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.skills).to.eql(['Python', 'Docker']);",
                  "    pm.expect(json.cvUrl).to.include('nora-diallo');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\n    \"Python\",\n    \"Docker\"\n  ],\n  \"cvUrl\": \"https://cv.example.com/nora-diallo.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "SCRUM-18 (upload CV) and SCRUM-19 (add skills)"
          }
        },
        {
          "name": "POST student - missing fields (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Response body is correct\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.include('Missing required fields');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nora\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST student - email already used (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Léa\",\n  \"lastName\": \"Martin\",\n  \"email\": \"lea.martin@edu.devinci.fr\",\n  \"program\": \"A4 DIA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET unknown student (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "9999"
              ]
            }
          }
        },
        {
          "name": "POST student to delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response body is correct\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set(\"deleteStudentId\", json.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Temp\",\n  \"lastName\": \"Student\",\n  \"email\": \"temp.student@edu.devinci.fr\",\n  \"program\": \"A4 OCC\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{deleteStudentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{deleteStudentId}}"
              ]
            }
          }
        },
        {
          "name": "GET deleted student (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{deleteStudentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{deleteStudentId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
