                  "pm.test(\"New patient has an id and the sent fields\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"id\");",
                  "    pm.expect(body.name).to.eql(\"Marie\");",
                  "    pm.expect(body.age).to.eql(29);",
                  "    pm.collectionVariables.set(\"patientId\", body.id);",
                  "});"
